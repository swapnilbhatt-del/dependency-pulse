{
  "name": "dependency-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "secrets:scan": "bash scripts/scan-secrets.sh",
    "preview:digest": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/preview-digest.ts",
    "verify:github": "tsx --tsconfig tsconfig.json scripts/verify-github.ts",
    "verify:gemini": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/verify-gemini.ts",
    "rebuild:digest": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/rebuild-digest.ts",
    "health:probe": "tsx --tsconfig tsconfig.json scripts/health-probe.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "p-limit": "^7.3.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.9"
}
