# ─── Dependency Pulse environment variables ───────────────────────────────
# Copy to .env for local development. Never commit .env.
# In Vercel set each of these for Production and Preview.

# Postgres connection string (Neon pooled URL, "...-pooler....neon.tech/...?sslmode=require").
DATABASE_URL=

# GitHub fine-grained personal access token, "Public repositories (read-only)", no write permissions.
GITHUB_TOKEN=

# Google AI Studio API key, and the Gemini Flash model id (verified: gemini-3.8-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend API key with sending access, and a From address on a domain verified in Resend.
# Without a verified domain use "Dependency Pulse <onboarding@resend.dev>" (delivers only to the Resend account owner).
RESEND_API_KEY=
EMAIL_FROM=

# Admin password for /admin (16+ characters, unique). Shared out of band, never committed.
ADMIN_PASSWORD=

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32+ random bytes. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Optional comma-separated default recipients (used when the recipients table is empty).
DIGEST_RECIPIENTS=

# Public base URL used in email links, e.g. https://dependency-pulse.vercel.app
APP_BASE_URL=http://localhost:3000

# Display-only timezone label for dates in the digest (all logic is UTC).
TIMEZONE_LABEL=Asia/Kolkata
